generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Trilha de auditoria imutável (ADR-0002, ADR-0004).
/// A regra de append-only (sem update/delete) é imposta na camada de
/// aplicação no ticket 04; aqui só a tabela existe.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actingAs    String?
  action      String
  targetType  String
  targetId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorUserId])
  @@index([createdAt])
}

// --- Notificação e outbox (ADR-0004, ticket 05) ---

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  DEAD
}

/// Intenção de efeito colateral gravada na MESMA transação de negócio.
/// Um worker (`processOutboxOnce`) despacha depois, com retry e idempotência.
model OutboxMessage {
  id          String       @id @default(cuid())
  topic       String
  payload     Json
  dedupeKey   String       @unique
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  claimId     String?
  claimedAt   DateTime?
  nextRetryAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, nextRetryAt])
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
  OPENED
}

/// Registro de cada tentativa de entrega, por canal.
model NotificationLog {
  id          String              @id @default(cuid())
  outboxId    String?
  recipient   String
  channel     NotificationChannel
  category    String
  status      NotificationStatus
  providerId  String?
  error       String?
  createdAt   DateTime            @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  @@index([recipient])
  @@index([outboxId])
}

/// Opt-out por categoria. Categorias transacionais são ignoradas aqui
/// (a regra é imposta em `src/domain/notifications.ts`).
model NotificationOptOut {
  subjectId String
  category  String
  createdAt DateTime @default(now())

  @@id([subjectId, category])
}
