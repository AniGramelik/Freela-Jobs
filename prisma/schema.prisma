generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Identidade e tenancy (ADR-0002, ticket 06) ---

enum CompanyRole {
  OWNER
  MANAGER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique // sempre normalizado (minúsculo, trim)
  passwordHash    String?
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  memberships CompanyMembership[]
  sessions    Session[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  memberships   CompanyMembership[]
  relationships WorkRelationship[]
  address       CompanyAddress?
  plan          CompanyPlan?
  jobPostings   JobPosting[]
  callOuts      CallOut[]
}

// --- Endereço e geografia da empresa (ADR-0006, ticket 09) ---

enum GeocodeStatus {
  PENDING
  OK
  FAILED
}

model CompanyAddress {
  id            String        @id @default(cuid())
  companyId     String        @unique
  line          String
  district      String?
  city          String
  state         String // UF
  zip           String?
  latitude      Float?
  longitude     Float?
  geocodeStatus GeocodeStatus @default(PENDING)
  geocodedAt    DateTime?
  radiusKm      Int           @default(20)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// --- Plano da empresa (ADR-0008, ticket 27) ---

enum CompanyPlanTier {
  FREE
  PAID
}

model CompanyPlan {
  companyId      String          @id
  tier           CompanyPlanTier @default(FREE)
  activeJobLimit Int             @default(3) // N do plano FREE (D10)
  updatedAt      DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CompanyMembership {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  tokenHash       String   @unique
  activeCompanyId String? // empresa "agindo como" (ticket 07)
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// --- Base privada de profissionais (ADR-0003, ticket 08) ---

enum ProfessionalProfileState {
  MANAGED
  INVITED
  CLAIMED
  ANONYMIZED
  MERGED
}

model ProfessionalProfile {
  id                 String                   @id @default(cuid())
  state              ProfessionalProfileState @default(MANAGED)
  fullName           String
  phoneE164          String
  email              String?
  createdByCompanyId String
  sourceNote         String?
  ownerUserId        String?                  @unique
  firstContactedAt   DateTime?
  mergedIntoId       String? // preenchido quando state = MERGED (ticket 12)
  availableNowUntil  DateTime? // "disponível agora" com expiração (ticket 13)
  baseCity           String? // localização-base declarada (ticket 16)
  baseState          String?
  latitude           Float?
  longitude          Float?
  createdAt          DateTime                 @default(now())

  relationships       WorkRelationship[]
  categories          ProfessionalProfileCategory[]
  invites             Invite[]
  availabilityWindows AvailabilityWindow[]
  callOutResponses    CallOutResponse[]
  internalRatings     InternalRating[]

  @@index([phoneE164])
}

// --- Disponibilidade do profissional (ticket 13) ---

enum AvailabilityShift {
  MORNING
  AFTERNOON
  NIGHT
}

model AvailabilityWindow {
  id                    String            @id @default(cuid())
  professionalProfileId String
  weekday               Int // 0 = domingo … 6 = sábado
  shift                 AvailabilityShift

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([professionalProfileId, weekday, shift])
  @@index([professionalProfileId])
}

// --- Convite para assumir o perfil (ADR-0003, ticket 10) ---

enum InviteState {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invite {
  id                    String      @id @default(cuid())
  professionalProfileId String
  companyId             String
  tokenHash             String      @unique
  channel               String // "email" | "sms"
  state                 InviteState @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime    @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([professionalProfileId])
}

// --- OTP de telefone para o claim (ADR-0003, ticket 11) ---

model PhoneOtp {
  id         String    @id @default(cuid())
  phoneE164  String
  codeHash   String
  purpose    String // "claim"
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneE164, purpose])
}

// --- Categoria profissional (ADR-0007, ticket 26) ---

model ProfessionalCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  regulated Boolean  @default(false)
  createdAt DateTime @default(now())

  profiles ProfessionalProfileCategory[]
}

model ProfessionalProfileCategory {
  professionalProfileId String
  categoryId            String

  professionalProfile ProfessionalProfile  @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)
  category            ProfessionalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([professionalProfileId, categoryId])
  @@index([categoryId])
}

enum WorkRelationshipState {
  ACTIVE
  PENDING_CONSENT
  ARCHIVED
}

model WorkRelationship {
  id                    String                @id @default(cuid())
  companyId             String
  professionalProfileId String
  state                 WorkRelationshipState @default(ACTIVE)
  roles                 String[]
  privateNote           String?
  createdAt             DateTime              @default(now())

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([companyId, professionalProfileId])
  @@index([companyId])
  @@index([professionalProfileId])
}

/// Janela fixa de rate limit por chave (ex.: "magiclink:email@x").
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime
}

/// Trilha de auditoria imutável (ADR-0002, ADR-0004).
/// A regra de append-only (sem update/delete) é imposta na camada de
/// aplicação no ticket 04; aqui só a tabela existe.
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actingAs    String?
  action      String
  targetType  String
  targetId    String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorUserId])
  @@index([createdAt])
}

// --- Notificação e outbox (ADR-0004, ticket 05) ---

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  DEAD
}

/// Intenção de efeito colateral gravada na MESMA transação de negócio.
/// Um worker (`processOutboxOnce`) despacha depois, com retry e idempotência.
model OutboxMessage {
  id          String       @id @default(cuid())
  topic       String
  payload     Json
  dedupeKey   String       @unique
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  claimId     String?
  claimedAt   DateTime?
  nextRetryAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  processedAt DateTime?

  @@index([status, nextRetryAt])
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
  OPENED
}

/// Registro de cada tentativa de entrega, por canal.
model NotificationLog {
  id          String              @id @default(cuid())
  outboxId    String?
  recipient   String
  channel     NotificationChannel
  category    String
  status      NotificationStatus
  providerId  String?
  error       String?
  createdAt   DateTime            @default(now())
  deliveredAt DateTime?
  openedAt    DateTime?

  @@index([recipient])
  @@index([outboxId])
}

/// Opt-out por categoria. Categorias transacionais são ignoradas aqui
/// (a regra é imposta em `src/domain/notifications.ts`).
model NotificationOptOut {
  subjectId String
  category  String
  createdAt DateTime @default(now())

  @@id([subjectId, category])
}

// --- Vaga pública (ADR-0007, ticket 28) ---

enum JobVinculo {
  DIARIA
  TEMPORARIO
  PJ
  CLT
  ESTAGIO
}

enum JobLocationMode {
  PRESENCIAL
  HIBRIDO
  REMOTO
}

enum JobPostingStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
  FILLED
}

model JobPosting {
  id                  String           @id @default(cuid())
  companyId           String
  title               String
  description         String
  categorySlug        String
  vinculo             JobVinculo
  locationMode        JobLocationMode
  city                String?
  state               String?
  latitude            Float?
  longitude           Float?
  radiusKm            Int?
  compensationText    String?
  positions           Int              @default(1)
  status              JobPostingStatus @default(DRAFT)
  applicationDeadline DateTime
  publishedAt         DateTime?
  featuredUntil       DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status, applicationDeadline])
  @@index([companyId, status])
  @@index([categorySlug])
}

// --- Convocação (ADR-0003, tickets 15, 16) ---

enum CallOutMode {
  TARGETED
  OPEN
}

enum CallOutStatus {
  DRAFT
  OPEN
  FILLED
  CLOSED
  CANCELLED
}

enum CallOutResponseState {
  OFFERED
  ACCEPTED
  DECLINED
  WITHDRAWN
  NO_SHOW
  COMPLETED
}

model CallOut {
  id               String        @id @default(cuid())
  companyId        String
  mode             CallOutMode
  role             String
  shiftDate        DateTime
  shiftStart       String
  shiftEnd         String?
  location         String
  compensationText String?
  notes            String?
  quantity         Int           @default(1)
  radiusKm         Int?
  status           CallOutStatus @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responses CallOutResponse[]

  @@index([companyId, status])
  @@index([status, shiftDate])
}

model CallOutResponse {
  id                    String               @id @default(cuid())
  callOutId             String
  professionalProfileId String
  state                 CallOutResponseState @default(OFFERED)
  respondedAt           DateTime?
  createdAt             DateTime             @default(now())

  callOut             CallOut             @relation(fields: [callOutId], references: [id], onDelete: Cascade)
  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@unique([callOutId, professionalProfileId])
  @@index([professionalProfileId])
}

// --- Avaliação interna (ADR-0003, ticket 17) ---

model InternalRating {
  id                    String   @id @default(cuid())
  companyId             String
  professionalProfileId String
  callOutId             String?
  score                 Int
  comment               String?
  createdAt             DateTime @default(now())

  professionalProfile ProfessionalProfile @relation(fields: [professionalProfileId], references: [id], onDelete: Cascade)

  @@index([companyId, professionalProfileId])
  @@index([professionalProfileId])
}
