# Postgres local (via Docker Compose: `docker compose up -d`)
DATABASE_URL="postgresql://freela:freela@localhost:5432/freela_jobs?schema=public"

# Ambiente: development | test | production
NODE_ENV="development"

# Log: trace | debug | info | warn | error | fatal  (default: info)
LOG_LEVEL="info"

# Error tracking (opcional; vazio = só log estruturado)
SENTRY_DSN=""
