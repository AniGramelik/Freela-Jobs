# Postgres local (via Docker Compose: `docker compose up -d`)
DATABASE_URL="postgresql://freela:freela@localhost:5432/freela_jobs?schema=public"

# Ambiente: development | test | production
NODE_ENV="development"

# Log: trace | debug | info | warn | error | fatal  (default: info)
LOG_LEVEL="info"

# Error tracking (opcional; vazio = só log estruturado)
SENTRY_DSN=""

# Worker de outbox
#   CRON_SECRET: bearer exigido pela rota /api/internal/outbox-tick (Vercel Cron)
#   WORKER_INTERVAL_MS: intervalo do worker autônomo `npm run worker`
CRON_SECRET=""
WORKER_INTERVAL_MS="5000"

# Testes de integração: se definido, usa este banco em vez do embedded-postgres
TEST_DATABASE_URL=""
